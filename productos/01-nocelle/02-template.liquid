<style>
.op-scope{ background:var(--op-bg); position:relative; }
.op-scope *,.op-scope *::before,.op-scope *::after{ box-sizing:border-box; }
.op-scope img{ max-width:100%; height:auto; display:block; }
.op-scope a:focus-visible, .op-scope button:focus-visible, .op-scope summary:focus-visible{
  outline:2px solid var(--op-secondary); outline-offset:2px;
}
@media (prefers-reduced-motion: reduce){
  .op-scope *{ transition-duration:0.01ms !important; }
}

.op-sec{ position:relative; z-index:1; padding-block:var(--op-section-gap); }
.op-sec--tight{ padding-block:calc(var(--op-section-gap) * .6); }
.op-sec--ink{ background:var(--op-inverse-surface); color:var(--op-inverse-ink); }

.op-eyebrow{
  display:inline-block; font-size:var(--op-t-label); letter-spacing:.05em; text-transform:uppercase;
  font-weight:600; color:var(--op-on-primary-container); background:var(--op-primary-container);
  padding:.3rem .75rem; border-radius:var(--op-r-full); margin:0 0 var(--op-stack-md);
}
.op-h1{
  font-family:var(--op-font-display); font-size:var(--op-t-h1);
  font-weight:700; line-height:1.1; letter-spacing:-.02em;
  margin:0 0 var(--op-stack-md); text-wrap:balance;
}
.op-h2{
  font-family:var(--op-font-display); font-size:var(--op-t-h2);
  font-weight:600; line-height:1.2; letter-spacing:-.01em;
  margin:0 0 var(--op-stack-md); text-wrap:balance;
}
.op-h3{
  font-family:var(--op-font-display); font-size:var(--op-t-h3);
  font-weight:600; line-height:1.3; margin:0 0 var(--op-stack-sm);
}
.op-lead{
  font-size:var(--op-t-lead); line-height:1.6; color:var(--op-muted);
  max-width:60ch; margin:0 0 var(--op-stack-lg);
}
.op-p{ font-size:var(--op-t-body); line-height:1.6; color:var(--op-muted); margin:0; }
.op-center{ text-align:center; }
.op-center .op-lead{ margin-inline:auto; }

.op-head{ max-width:42rem; margin:0 auto calc(var(--op-stack-lg) * 1.5); text-align:center; }
.op-head .op-lead{ margin-bottom:0; }

/* -- Hero -- */
.op-hero{ display:grid; gap:clamp(2rem,5vw,4rem); align-items:center; padding-block:var(--op-section-gap); }
@media (min-width:900px){ .op-hero{ grid-template-columns:1fr 1fr; } }
.op-hero__media{ position:relative; }
.op-hero__media img{
  width:100%; border-radius:var(--op-r-xl);
  box-shadow:var(--op-shadow-ambient);
}
.op-hero__ph{
  aspect-ratio:4/5; background:rgba(255,255,255,.55);
  backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
  border:1px solid rgba(255,255,255,.6); box-shadow:var(--op-shadow-ambient);
  border-radius:var(--op-r-xl); display:flex; align-items:center; justify-content:center;
  color:var(--op-muted); font-size:var(--op-t-sm); font-weight:500;
}

/* -- Precio + compra -- */
.op-price{ display:flex; align-items:baseline; gap:var(--op-stack-sm); margin-bottom:var(--op-stack-lg); }
.op-price__now{ font-family:var(--op-font-display); font-size:var(--op-t-h3); font-weight:700; font-variant-numeric:tabular-nums; }
.op-price__was{ font-size:var(--op-t-body); color:var(--op-outline-variant); text-decoration:line-through; font-variant-numeric:tabular-nums; }
.op-price__save{
  font-size:var(--op-t-label); font-weight:600; letter-spacing:.03em;
  background:var(--op-secondary-container); color:var(--op-on-secondary-container);
  padding:.25rem .6rem; border-radius:var(--op-r-full);
}

.op-btn{
  display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
  width:100%; padding:1rem 2rem; border:0; cursor:pointer;
  background:var(--op-secondary); color:var(--op-on-secondary);
  font-family:var(--op-font-body); font-size:var(--op-t-body); font-weight:600;
  border-radius:var(--op-r-md); text-decoration:none;
  box-shadow:0 12px 24px -8px rgba(108,69,192,.45);
  transition:background .25s var(--op-ease), transform .25s var(--op-ease), box-shadow .25s var(--op-ease);
}
.op-btn:hover{ background:#5C3AA8; transform:translateY(-1px); box-shadow:0 16px 30px -8px rgba(108,69,192,.55); }
.op-btn:disabled{ background:var(--op-outline-variant); color:var(--op-muted); cursor:not-allowed; transform:none; box-shadow:none; }
.op-micro{
  margin:var(--op-stack-sm) 0 0; text-align:center;
  font-size:var(--op-t-sm); color:var(--op-muted);
}

/* -- Tira de confianza -- */
.op-trust__grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:var(--op-stack-md); }
@media (min-width:760px){ .op-trust__grid{ grid-template-columns:repeat(4,1fr); } }
.op-trust__item{
  background:rgba(255,255,255,.6); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.7); border-radius:var(--op-r-md);
  padding:var(--op-stack-md); text-align:center; font-size:var(--op-t-sm); font-weight:500; color:var(--op-muted);
}

/* -- Rejillas -- */
.op-grid{ display:grid; gap:var(--op-stack-lg); }
.op-grid--3{ grid-template-columns:1fr; }
.op-grid--4{ grid-template-columns:1fr; }
@media (min-width:700px){ .op-grid--4{ grid-template-columns:repeat(2,1fr); } }
@media (min-width:900px){
  .op-grid--3{ grid-template-columns:repeat(3,1fr); }
  .op-grid--4{ grid-template-columns:repeat(4,1fr); }
}

/* -- Tarjeta vidrio (glassmorphism) -- */
.op-card{
  background:rgba(255,255,255,.7); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.8); border-radius:var(--op-r-lg);
  box-shadow:var(--op-shadow-ambient); padding:var(--op-stack-lg);
}
.op-card__num{
  font-family:var(--op-font-display); font-size:var(--op-t-h3);
  color:var(--op-secondary); line-height:1; margin-bottom:var(--op-stack-md);
  display:block; font-weight:700;
}

/* -- Especificaciones -- */
.op-specs{
  max-width:36rem; margin-inline:auto;
  background:rgba(255,255,255,.7); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.8); border-radius:var(--op-r-lg);
  box-shadow:var(--op-shadow-ambient); padding:var(--op-stack-lg) calc(var(--op-stack-lg) * 1.25);
}
.op-specs__row{
  display:flex; justify-content:space-between; gap:var(--op-stack-md);
  padding-block:var(--op-stack-md); border-bottom:1px solid var(--op-outline-variant);
  font-size:var(--op-t-body);
}
.op-specs__row:last-child{ border-bottom:0; }
.op-specs__k{ color:var(--op-muted); }
.op-specs__v{ text-align:right; }

/* -- Comparativa -- */
.op-cmp{
  max-width:42rem; margin-inline:auto; overflow-x:auto;
  background:rgba(255,255,255,.7); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.8); border-radius:var(--op-r-lg); box-shadow:var(--op-shadow-ambient);
}
.op-cmp table{ width:100%; border-collapse:collapse; font-size:var(--op-t-body); }
.op-cmp th,.op-cmp td{ padding:var(--op-stack-md); text-align:left; border-bottom:1px solid var(--op-outline-variant); }
.op-cmp th{
  font-size:var(--op-t-label); letter-spacing:.04em; text-transform:uppercase;
  font-weight:600; color:var(--op-muted);
}
.op-cmp td:not(:first-child),.op-cmp th:not(:first-child){ text-align:center; width:8rem; }
.op-cmp thead th:nth-child(2){ color:var(--op-secondary); }
.op-cmp tr:last-child td{ border-bottom:0; }
.op-cmp .op-yes{ color:var(--op-secondary); font-size:1.125rem; }
.op-cmp .op-no{ color:var(--op-outline-variant); font-size:1.125rem; }

/* -- Testimonios -- */
.op-quote{ font-family:var(--op-font-display); font-size:var(--op-t-h3); font-weight:600; line-height:1.4; margin:0 0 var(--op-stack-md); }
.op-byline{ font-size:var(--op-t-label); letter-spacing:.05em; text-transform:uppercase; color:var(--op-muted); }

/* -- Garantía -- */
.op-gua{ max-width:34rem; margin-inline:auto; text-align:center; }

/* -- FAQ -- */
.op-faq{ max-width:42rem; margin-inline:auto; }
.op-faq details{
  background:rgba(255,255,255,.7); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border:1px solid rgba(255,255,255,.8); border-radius:var(--op-r-md);
  margin-bottom:var(--op-stack-sm); box-shadow:0 8px 20px -10px rgba(108,69,192,.12);
}
.op-faq summary{
  cursor:pointer; list-style:none; padding:var(--op-stack-md) var(--op-stack-lg);
  display:flex; justify-content:space-between; align-items:center; gap:var(--op-stack-md);
  font-size:var(--op-t-body); font-weight:600;
}
.op-faq summary::-webkit-details-marker{ display:none; }
.op-faq summary::after{
  content:'+'; font-size:1.25rem; color:var(--op-secondary); flex:none;
  transition:transform .25s var(--op-ease);
}
.op-faq details[open] summary::after{ transform:rotate(45deg); }
.op-faq__a{ padding:0 var(--op-stack-lg) var(--op-stack-lg); }

/* -- ATC fija en móvil -- */
.op-sticky{
  position:fixed; inset-inline:0; bottom:0; z-index:60;
  background:rgba(255,255,255,.92); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  border-top:1px solid var(--op-outline-variant);
  padding:var(--op-stack-sm) var(--op-stack-md);
  display:flex; align-items:center; gap:var(--op-stack-md);
  transform:translateY(110%); transition:transform .3s var(--op-ease);
  padding-bottom:calc(var(--op-stack-sm) + env(safe-area-inset-bottom));
}
.op-sticky.is-on{ transform:translateY(0); }
.op-sticky__price{ font-family:var(--op-font-display); font-size:var(--op-t-h3); font-weight:700; flex:none; font-variant-numeric:tabular-nums; }
.op-sticky form{ flex:1; margin:0; }
.op-sticky .op-btn{ padding-block:.75rem; box-shadow:none; }
@media (min-width:900px){ .op-sticky{ display:none; } }
</style>

<div class="op-scope">

  <!-- ============ HERO ============ -->
  <section class="op-wrap op-hero">
    <div>
      <p class="op-eyebrow">{{ EYEBROW }}</p>
      <h1 class="op-h1">{{ H1 }}</h1>
      <p class="op-lead">{{ SUB }}</p>

      {%- if p != blank -%}
        <div class="op-price">
          <span class="op-price__now">{{ p.price | money }}</span>
          {%- if p.compare_at_price > p.price -%}
            <span class="op-price__was">{{ p.compare_at_price | money }}</span>
            {%- assign pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
            <span class="op-price__save">-{{ pct }}%</span>
          {%- endif -%}
        </div>

        <form method="post" action="/cart/add" id="op-atc">
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="&#10003;">
          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="op-btn" {% unless p.available %}disabled{% endunless %}>
            {% if p.available %}{{ CTA }}{% else %}{{ SOLD_OUT }}{% endif %}
          </button>
        </form>
        <p class="op-micro">{{ MICRO }}</p>
      {%- else -%}
        <p class="op-p"><strong>Aviso:</strong> no se encuentra el producto
        <code>{{ PRODUCT_HANDLE }}</code>. Revisa PRODUCT_HANDLE en la zona editable.</p>
      {%- endif -%}
    </div>

    <div class="op-hero__media">
      {%- if p != blank and p.featured_image -%}
        <img src="{{ p.featured_image | image_url: width: 1200 }}"
             alt="{{ p.featured_image.alt | escape }}" width="1200" height="1500" loading="eager">
      {%- else -%}
        <div class="op-hero__ph">Imagen del producto</div>
      {%- endif -%}
    </div>
  </section>

  <!-- ============ CONFIANZA ============ -->
  <section class="op-trust">
    <div class="op-trust__grid">
      {%- assign trust_items = TRUST | split: '|' -%}
      {%- for t in trust_items -%}
        <div class="op-trust__item">{{ t }}</div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ============ PROBLEMA ============ -->
  <section class="op-sec op-wrap">
    <div class="op-head"><h2 class="op-h2">{{ PROB_TITLE }}</h2></div>
    <div class="op-grid op-grid--3">
      {%- assign prob_items = PROB | split: '|' -%}
      {%- for item in prob_items -%}
        <div class="op-card">
          <p class="op-p">{{ item }}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ============ CÓMO FUNCIONA ============ -->
  <section class="op-sec">
    <div class="op-wrap">
      <div class="op-head"><h2 class="op-h2">{{ HOW_TITLE }}</h2></div>
      <div class="op-grid op-grid--3">
        {%- assign how_items = HOW | split: '|' -%}
        {%- for item in how_items -%}
          {%- assign parts = item | split: '::' -%}
          <div class="op-card">
            <span class="op-card__num">{{ forloop.index }}</span>
            <h3 class="op-h3">{{ parts[0] }}</h3>
            <p class="op-p">{{ parts[1] }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- ============ BENEFICIOS ============ -->
  <section class="op-sec op-wrap">
    <div class="op-head"><h2 class="op-h2">{{ BEN_TITLE }}</h2></div>
    <div class="op-grid op-grid--4">
      {%- assign ben_items = BEN | split: '|' -%}
      {%- for item in ben_items -%}
        {%- assign parts = item | split: '::' -%}
        <div class="op-card">
          <h3 class="op-h3">{{ parts[0] }}</h3>
          <p class="op-p">{{ parts[1] }}</p>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ============ ESPECIFICACIONES ============ -->
  <section class="op-sec op-sec--tight op-wrap">
    <div class="op-head"><h2 class="op-h2">{{ SPEC_TITLE }}</h2></div>
    <div class="op-specs">
      {%- assign spec_items = SPECS | split: '|' -%}
      {%- for item in spec_items -%}
        {%- assign parts = item | split: '::' -%}
        <div class="op-specs__row">
          <span class="op-specs__k">{{ parts[0] }}</span>
          <span class="op-specs__v">{{ parts[1] }}</span>
        </div>
      {%- endfor -%}
    </div>
  </section>

  <!-- ============ COMPARATIVA ============ -->
  <section class="op-sec op-sec--tight op-wrap">
    <div class="op-head"><h2 class="op-h2">{{ CMP_TITLE }}</h2></div>
    <div class="op-cmp">
      <table>
        <thead>
          <tr><th></th><th>{{ CMP_US }}</th><th>{{ CMP_THEM }}</th></tr>
        </thead>
        <tbody>
          {%- assign cmp_items = CMP_ROWS | split: '|' -%}
          {%- for item in cmp_items -%}
            {%- assign parts = item | split: '::' -%}
            <tr>
              <td>{{ parts[0] }}</td>
              <td>{% if parts[1] == '1' %}<span class="op-yes">&#9679;</span>{% else %}<span class="op-no">&#9675;</span>{% endif %}</td>
              <td>{% if parts[2] == '1' %}<span class="op-yes">&#9679;</span>{% else %}<span class="op-no">&#9675;</span>{% endif %}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ============ TESTIMONIOS (solo si SHOW_REVIEWS = true) ============ -->
  {%- if SHOW_REVIEWS -%}
  <section class="op-sec">
    <div class="op-wrap">
      <div class="op-head"><h2 class="op-h2">{{ REV_TITLE }}</h2></div>
      <div class="op-grid op-grid--3">
        {%- assign rev_items = REV | split: '|' -%}
        {%- for item in rev_items -%}
          {%- assign parts = item | split: '::' -%}
          <figure class="op-card" style="margin:0">
            <blockquote class="op-quote">&ldquo;{{ parts[1] }}&rdquo;</blockquote>
            <figcaption class="op-byline">{{ parts[0] }}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- ============ GARANTÍA ============ -->
  <section class="op-sec op-sec--tight op-wrap">
    <div class="op-gua">
      <h2 class="op-h2">{{ GUA_TITLE }}</h2>
      <p class="op-p">{{ GUA_BODY }}</p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="op-sec op-wrap">
    <div class="op-head"><h2 class="op-h2">{{ FAQ_TITLE }}</h2></div>
    <div class="op-faq">
      {%- assign faq_items = FAQ | split: '|' -%}
      {%- for item in faq_items -%}
        {%- assign parts = item | split: '::' -%}
        <details{% if forloop.first %} open{% endif %}>
          <summary>{{ parts[0] }}</summary>
          <div class="op-faq__a"><p class="op-p">{{ parts[1] }}</p></div>
        </details>
      {%- endfor -%}
    </div>
  </section>

  <!-- ============ CTA FINAL ============ -->
  {%- if p != blank -%}
  <section class="op-sec op-sec--ink">
    <div class="op-wrap op-center">
      <h2 class="op-h2">{{ FIN_TITLE }}</h2>
      <p class="op-lead" style="color:rgba(240,241,241,.7)">{{ SUB }}</p>
      <form method="post" action="/cart/add" style="max-width:22rem;margin-inline:auto">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="&#10003;">
        <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="op-btn" style="background:var(--op-primary-container);color:var(--op-on-primary-container);box-shadow:none"
                {% unless p.available %}disabled{% endunless %}>
          {% if p.available %}{{ CTA }} &middot; {{ p.price | money }}{% else %}{{ SOLD_OUT }}{% endif %}
        </button>
      </form>
      <p class="op-micro" style="color:rgba(240,241,241,.55)">{{ MICRO }}</p>
    </div>
  </section>

  <!-- ============ ATC FIJA MÓVIL ============ -->
  <div class="op-sticky" id="op-sticky">
    <span class="op-sticky__price">{{ p.price | money }}</span>
    <form method="post" action="/cart/add">
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="&#10003;">
      <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="op-btn" {% unless p.available %}disabled{% endunless %}>
        {% if p.available %}{{ CTA }}{% else %}{{ SOLD_OUT }}{% endif %}
      </button>
    </form>
  </div>
  {%- endif -%}

</div>

<script>
(function(){
  var bar = document.getElementById('op-sticky');
  var top = document.getElementById('op-atc');
  if(!bar || !top || !('IntersectionObserver' in window)) return;
  new IntersectionObserver(function(entries){
    bar.classList.toggle('is-on', !entries[0].isIntersecting);
  }, { rootMargin: '0px 0px -100% 0px' }).observe(top);
})();
</script>
